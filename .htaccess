# ==============================================================================
# SECURE PRODUCTION APACHE / LITESPEED HARDENING CONFIGURATION
# Website: Rehan Ayaz Portfolio (https://rehanayaz.com)
# ==============================================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes -MultiViews

# 2. Block Access to Hidden & Sensitive Files (.git, .env, .bak, .log, etc.)
<FilesMatch "^\.(?!well-known)">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git|yml|yaml|jsonl)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Disable Dangerous / Unused HTTP Methods
<LimitExcept GET POST HEAD OPTIONS>
    Order allow,deny
    Deny from all
</LimitExcept>

# 4. Enforce UTF-8 Character Encoding
AddDefaultCharset UTF-8

# 5. Security & Browser Hardening Headers
<IfModule mod_headers.c>
    # Prevent MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking Protection (Disallow framing)
    Header always set X-Frame-Options "DENY"

    # Cross-Origin Policies
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (Restrict camera, mic, geolocation, payments)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # HTTP Strict Transport Security (HSTS) - Enabled for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Content Security Policy (Strictly tailored for Google Fonts, Remixicon, YouTube video embed, and GSAP transforms)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data: https:; media-src 'self'; frame-src https://www.youtube.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me; frame-ancestors 'none'; upgrade-insecure-requests;"
</IfModule>

# 6. HTTPS Redirection (Production Mode)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 7. Safe Custom Error Document
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
